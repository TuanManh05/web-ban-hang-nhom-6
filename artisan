<?php

declare(strict_types=1);

if (($argv[1] ?? '') !== 'migrate:fresh' || !in_array('--seed', $argv, true)) {
    fwrite(STDERR, "Cách dùng: php artisan migrate:fresh --seed\n");
    exit(1);
}

$localFile = __DIR__ . '/config/database.local.php';
$local = is_file($localFile) ? require $localFile : [];
$host = getenv('DB_HOST') ?: ($local['host'] ?? '127.0.0.1');
$port = getenv('DB_PORT') ?: ($local['port'] ?? '3306');
$databaseName = getenv('DB_NAME') ?: ($local['name'] ?? 'web_ban_hang_nhom_6');
$user = getenv('DB_USER') ?: ($local['user'] ?? 'root');
$password = getenv('DB_PASSWORD') ?: ($local['password'] ?? '');

if (!preg_match('/^[A-Za-z0-9_]+$/', $databaseName)) {
    fwrite(STDERR, "Tên database không hợp lệ.\n");
    exit(1);
}

$options = [
    PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION,
    PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
    PDO::ATTR_EMULATE_PREPARES => false,
];

try {
    $server = new PDO("mysql:host={$host};port={$port};charset=utf8mb4", $user, $password, $options);
    $server->exec("DROP DATABASE IF EXISTS `{$databaseName}`");
    $server->exec("CREATE DATABASE `{$databaseName}` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci");

    $pdo = new PDO(
        "mysql:host={$host};port={$port};dbname={$databaseName};charset=utf8mb4",
        $user,
        $password,
        $options
    );

    $schema = (string) file_get_contents(__DIR__ . '/database/database.sql');
    $schema = preg_replace('/^CREATE DATABASE.*?;\s*USE\s+[^;]+;/is', '', $schema, 1);
    $pdo->exec((string) $schema);

    require_once __DIR__ . '/database/seeders/DatabaseSeeder.php';
    (new DatabaseSeeder($pdo))->run();

    $counts = [
        'users' => (int) $pdo->query('SELECT COUNT(*) FROM users')->fetchColumn(),
        'categories' => (int) $pdo->query('SELECT COUNT(*) FROM categories')->fetchColumn(),
        'products' => (int) $pdo->query('SELECT COUNT(*) FROM products')->fetchColumn(),
    ];

    echo "Tạo lại database và dữ liệu mẫu thành công.\n";
    echo "Users: {$counts['users']}; Categories: {$counts['categories']}; Products: {$counts['products']}\n";
} catch (Throwable $exception) {
    fwrite(STDERR, "Không thể tạo dữ liệu mẫu: {$exception->getMessage()}\n");
    exit(1);
}
